# Ejemplo de configuración. NO pongas aquí datos reales: este archivo se sube a GitHub.
# Los valores reales se pegan en Streamlit Cloud: tu app -> Settings -> Secrets.
# (En local, si quisieras usarlos, irían en .streamlit/secrets.toml, que NO se sube a GitHub.)

# Dirección de la base de datos PostgreSQL (la que da Supabase). Sin esta línea se usa el
# archivo local database.db, que en Streamlit Cloud se pierde al reiniciar.
DATABASE_URL = "postgresql://usuario:contrasena@host:6543/postgres"

# Solo para una primera prueba: crea el edificio de demostración si no existe.
# ENERGIA_DEMO = "1"

# Personas que pueden entrar. Una línea por persona; se generan con "Crear usuario.bat".
# Si no hay ninguna línea, la app se abre sin contraseña.
[usuarios]
# maria = "pbkdf2_sha256$240000$...$..."
